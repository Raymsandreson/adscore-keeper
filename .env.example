# Modelo do .env — SEM VALORES. Copie para .env e preencha.
#
# O .env de verdade saiu do rastreio do git em 05/08/2026 (estava commitado
# desde antes do .gitignore existir). Nenhum segredo forte vazou: eram chaves
# publishable/anon e IDs de projeto. Ainda assim, chave em repo é chave que
# ninguém consegue rotacionar sem reescrever histórico.
#
# ATENÇÃO — quebra de build: src/integrations/supabase/client.ts lê
# VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY em tempo de build, sem
# fallback. Se faltarem, createClient recebe undefined e o app não sobe.
# Antes de publicar, as duas PRECISAM existir nas variáveis de ambiente do
# Lovable e do Railway — não adianta estarem só na sua máquina.

# Supabase usado pelo front (hoje aponta pro projeto do Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Mesmos valores sem o prefixo VITE_, usados fora do bundle do Vite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Roteamento de banco (ver src/integrations/supabase/) — 'external' | 'cloud'
VITE_DB_ROUTING_MODE=

# Conectores do Lovable
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
